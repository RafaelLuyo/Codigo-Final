# Imagen base con AWS CLI
FROM amazon/aws-cli:latest

# Instalar herramientas de backup para cada base de datos
# En Amazon Linux 2023: mysql-client es mariadb105, postgresql15 está disponible
# Cache bust: v2
RUN yum update -y && \
    yum install -y \
    postgresql15 \
    mariadb105 \
    tar \
    gzip && \
    yum clean all

# Instalar MongoDB Tools (mongodump)
RUN curl -fsSL https://fastdl.mongodb.org/tools/db/mongodb-database-tools-amazon2023-x86_64-100.9.4.rpm -o mongodb-tools.rpm && \
    yum install -y mongodb-tools.rpm && \
    rm mongodb-tools.rpm && \
    yum clean all

# Copiar el script de backup
COPY backup-script.sh /backup-script.sh
RUN chmod +x /backup-script.sh

# Punto de entrada
ENTRYPOINT ["/bin/bash"]
CMD ["/backup-script.sh"]